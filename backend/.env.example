PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Use separate Atlas SRV URLs, each pointing to the intended database.
EMERGENCY_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
BOOKING_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Optional for local development; SOS images remain as data URLs when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
